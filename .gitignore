node_modules/
venv/
data/
.worktrees/
.superpowers/

# macOS junk
.DS_Store

# Python bytecode, generated by any import or py_compile
__pycache__/
*.pyc

# Editor/agent config, including the local dev-server definition. Stays on
# disk (the preview server reads launch.json) but is not shared --
# settings.local.json is per-machine by design.
#
# Written as `.claude/*` rather than `.claude/` so the exception below can work
# at all: git cannot re-include anything inside a directory that is itself
# excluded.
.claude/*

# The subagents ARE project knowledge, not machine setup. The verifier encodes
# what to distrust about work in this repo, so it is worthless on the one
# machine that already has it and worth having in every clone.
!.claude/agents/

# A 712KB generated architecture render from 2026-09-01. Kept locally to look
# at; too large and too stale to carry in the repo.
docs/architecture.html

# Archify visual-check evidence (regenerable, ~700KB of PNGs)
docs/*.visual-check.*
